{
  "version": "1.0",
  "types": {
    "outcome": {
      "label": "Outcome",
      "description": "A result you set targets for. If this misses, someone has a hard conversation."
    },
    "leading": {
      "label": "Leading",
      "description": "A signal that predicts an outcome before it materialises. Changing this today changes an outcome next quarter."
    },
    "efficiency": {
      "label": "Efficiency",
      "description": "A ratio that measures conversion of inputs to outputs. You benchmark this against peers."
    },
    "operational": {
      "label": "Operational",
      "description": "A volume, velocity or process metric you manage day-to-day. The machinery of the business."
    }
  },
