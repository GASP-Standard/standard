      "metric": "gasp_breadth_of_adoption",
      "gasp_id": "breadth_of_adoption",
      "formula": "count_distinct(field.customer_id, field.feature_id) / metric.active_accounts",
      "unit": "ratio",
      "datasets": [
        "product_event"
      ],
      "columns": [
        "value"
      ],
