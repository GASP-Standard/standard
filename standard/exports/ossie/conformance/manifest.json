  "cases": [
    {
      "id": "c01_cohort_nrr",
      "reason": "cohort",
      "construct": "a cohort fixed at the opening of the period and followed through its events (Net Revenue Retention)",
      "metric": "gasp_nrr",
      "gasp_id": "nrr",
      "formula": "(metric.mrr at period_start + metric.expansion_mrr - metric.contraction_mrr - metric.churned_mrr) / metric.mrr at period_start over cohort(field.customer_id, period_start)",
      "unit": "percent",
      "datasets": [
        "revenue_event",
        "customer",
        "subscription"
      ],
      "columns": [
        "value"
      ],
      "expected": [
        {
          "value": 0.9867549668874173
        }
      ],
      "canonical": "https://gaspwiki.com/v1/metrics/core/net-revenue-retention-nrr"
    },
    {
      "id": "c02_lag_mrr_growth_rate",
      "reason": "lag",
      "construct": "the same aggregate one period earlier (period-over-period growth)",
      "metric": "gasp_mrr_growth_rate",
      "gasp_id": "mrr_growth_rate",
      "formula": "(metric.mrr - lag(metric.mrr, 1 month)) / lag(metric.mrr, 1 month)",
      "unit": "percent",
      "datasets": [
        "subscription"
      ],
      "columns": [
        "value"
      ],
      "expected": [
        {
          "value": 0.11009174311926606
        }
      ],
      "canonical": "https://gaspwiki.com/v1/metrics/core/mrr-growth-rate"
    },
    {
      "id": "c03_at_period_start_logo_churn_rate",
      "reason": "at period_start",
      "construct": "a snapshot read at the opening of the period beside events inside it",
      "metric": "gasp_logo_churn_rate",
      "gasp_id": "logo_churn_rate",
      "formula": "metric.churned_customers / metric.total_customers at period_start",
      "unit": "percent",
      "datasets": [
        "revenue_event",
        "customer"
      ],
      "columns": [
        "value"
      ],
      "expected": [
        {
          "value": 0.25
        }
      ],
      "canonical": "https://gaspwiki.com/v1/metrics/core/logo-churn-rate-customer-churn"
    },
    {
      "id": "c04_total_ticket_distribution_by_type",
      "reason": "total",
      "construct": "a share of the ungrouped total inside a breakdown",
      "metric": "gasp_ticket_distribution_by_type",
      "gasp_id": "ticket_distribution_by_type",
      "formula": "count_distinct(field.ticket_id) / total(metric.ticket_volume)",
      "unit": "percent",
      "datasets": [
        "ticket"
      ],
      "columns": [
        "ticket_type",
        "value"
      ],
      "expected": [
