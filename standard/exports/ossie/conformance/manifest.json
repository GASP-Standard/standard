    {
      "id": "c11_all_time_user_retention_day_n",
      "reason": "all_time",
      "construct": "an unbounded range beside a bounded one (users who signed up in the period, active any time after)",
      "metric": "gasp_user_retention_day_n",
      "gasp_id": "user_retention_day_n",
      "formula": "all_time(count_distinct(field.user_id where field.product_event_type = 'qualifying' and in_period(field.signup_date) and (field.event_date - field.signup_date) = 30)) / count_distinct(field.user_id where in_period(field.signup_date))",
      "unit": "percent",
      "datasets": [
        "user",
        "product_event"
