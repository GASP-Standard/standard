      "rows": 328,
      "slice": "snapshot rows on month starts, month ends and the period bounds shifted back by one, three, six and twelve months"
    },
    "opportunity": {
      "rows": 218,
      "slice": "snapshot rows on month starts, month ends and the period bounds shifted back by one, three, six and twelve months"
    },
