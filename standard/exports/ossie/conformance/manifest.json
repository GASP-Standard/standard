          "ticket_type": "account",
          "value": 0.0967741935483871
        },
        {
          "ticket_type": "billing",
          "value": 0.12903225806451613
        },
        {
          "ticket_type": "bug",
          "value": 0.25806451612903225
        },
        {
          "ticket_type": "feature_request",
          "value": 0.0967741935483871
        },
        {
          "ticket_type": "how_to",
          "value": 0.3225806451612903
        },
        {
          "ticket_type": "other",
          "value": 0.0967741935483871
        }
      ],
      "canonical": "https://gaspwiki.com/v1/metrics/support/ticket-distribution-by-type"
    },
    {
      "id": "c05_period_bound_in_filter_win_rate",
      "reason": "period bound in filter",
      "construct": "the reporting period bound to a field other than the dataset's time field (opportunities by close date on a snapshot)",
      "metric": "gasp_win_rate",
      "gasp_id": "win_rate",
      "formula": "count(field.opportunity_id where field.opportunity_stage = 'closed_won' and in_period(field.close_date)) / count(field.opportunity_id where field.opportunity_stage in ('closed_won', 'closed_lost') and in_period(field.close_date))",
      "unit": "percent",
      "datasets": [
        "opportunity"
      ],
      "columns": [
        "value"
      ],
      "expected": [
        {
          "value": 0.5
        }
      ],
      "canonical": "https://gaspwiki.com/v1/metrics/sales/win-rate"
    },
    {
      "id": "c06_to_date_ticket_backlog",
      "reason": "to_date",
      "construct": "an aggregate cumulative from the start of history to the period end",
      "metric": "gasp_ticket_backlog",
      "gasp_id": "ticket_backlog",
      "formula": "count_distinct(field.ticket_id where field.ticket_status in ('open', 'pending')) at period_end",
      "unit": "count",
      "datasets": [
        "ticket"
      ],
      "columns": [
        "value"
      ],
      "expected": [
        {
          "value": 7
        }
      ],
      "canonical": "https://gaspwiki.com/v1/metrics/support/ticket-backlog"
    },
    {
      "id": "c07_period_days_uptime",
      "reason": "period_days",
      "construct": "the number of days in the reporting period as a value",
      "metric": "gasp_uptime",
      "gasp_id": "uptime",
      "formula": "1 - sum(field.downtime_minutes) / (period_days * 1440)",
      "unit": "percent",
      "datasets": [
        "service_metrics"
      ],
      "columns": [
        "value"
      ],
      "expected": [
        {
          "value": 0.9997582872928177
        }
      ],
      "canonical": "https://gaspwiki.com/v1/metrics/engineering/uptime-availability"
